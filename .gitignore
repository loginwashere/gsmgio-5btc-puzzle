__pycache__/
*.pyc

# Runtime checkpoints: lock sentinels are transient; keep the JSONL data itself.
tools/gsmg/*.jsonl.lock

# Phase 478 generated candidate corpora. These are reproducible from the
# committed locks/scripts but are far too large for ordinary Git hosting
# (raw capture ~630 MiB; annotated manifest ~1.7 GiB). Their hashes remain
# recorded in the Phase 478 audit/lock/checksum artifacts.
tools/gsmg/phase478_raw_capture.jsonl
tools/gsmg/phase478_manifest.jsonl

# Obsidian: keep shared vault config, ignore personal workspace/UI state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/*.log

# Large external asset: funded/used-address Bloom filter copied from
# ../key-seeker/db/addresses.hash160.bloom (BLMCACHE v1 format). Not
# reproducible from anything else in this repo -- see binary_key_material_backfill.py.
db/*.bloom

# Scratch/build working directory: compiled CUDA binaries and rolling-search
# checkpoint .npz files, all reproducible from the committed phase484* scripts
# and their binary sources. Far too large and too transient for Git hosting.
_work/
