# Adapted from ../../../key-seeker/Dockerfile.cuda (same builder/runtime split,
# same sm_120-for-RTX-5070 default) -- see the approved plan for why this
# tool has its own Dockerfile rather than reusing key-seeker's image: this is
# a different crate entirely, though as of Phase 324 it does depend on
# secp256k1/ripemd/bs58/ureq too (ported checker/crypto modules, see
# src/checker/ and src/crypto.rs) -- gcc/pkg-config/libssl-dev below already
# cover secp256k1-sys's and ring's native builds; no image changes were
# needed for those. ureq resolved to rustls+webpki-roots (bundled root CA
# store), not native-tls/openssl, so the runtime stage needs no TLS runtime
# package either.

# ── Stage 1: build (CUDA toolkit + Rust) ──────────────────────────────────────
FROM nvidia/cuda:13.0.0-devel-ubuntu22.04 AS builder

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4; \
    rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list 2>/dev/null; \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# Cache dependencies first.
COPY Cargo.toml Cargo.lock* ./
RUN mkdir -p src \
    && echo 'fn main(){}' > src/main.rs \
    && cargo build --release --features cuda --bin gpu_oracle \
    && rm -rf src

# Native RTX 50-series PTX target (compute capability 12.0, confirmed via
# `nvidia-smi --query-gpu=compute_cap` on the dev machine). Override for a
# different card; local non-Docker builds retain build.rs's own sm_120 default.
ARG GO_CUDA_ARCH=sm_120

COPY src ./src
COPY kernels ./kernels
COPY build.rs ./
RUN touch src/main.rs && GO_CUDA_ARCH="${GO_CUDA_ARCH}" \
    cargo build --release --features cuda --bin gpu_oracle

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM nvidia/cuda:13.0.0-runtime-ubuntu22.04

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4; \
    rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list 2>/dev/null; \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/gpu_oracle /usr/local/bin/gpu_oracle

# /data/db is where --bloom-cache's default looks for
# addresses.hash160.bloom (see main.rs's default_bloom_cache_path) -- mount
# the repo's db/ there read-only:
#   docker run --gpus all \
#     -v $(pwd)/db:/data/db:ro \
#     -v $(pwd)/wordlists:/data/wordlists:ro \
#     -v $(pwd)/output:/data/output \
#     gpu_oracle --wordlist /data/wordlists/x.txt
# Bloom cache is optional: a missing/unmounted /data/db/addresses.hash160.bloom
# is a warning, not a failure -- structural hits are still derived and
# logged, just never Bloom/API-checked (pass --no-bloom-verify to silence
# the warning intentionally).
RUN mkdir -p /data/output /data/checkpoints /data/wordlists /data/db

WORKDIR /data

ENTRYPOINT ["gpu_oracle"]
CMD ["--help"]
