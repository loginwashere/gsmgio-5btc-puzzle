        <mxCell id="n1067" parent="n1047" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#c9a227;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Courier New;" value="METHOD: password = sha256(part1 + part2 + ... + part7), no separators&lt;br&gt;1: causality&lt;br&gt;2: Safenet&lt;br&gt;3: Luna&lt;br&gt;4: HSM&lt;br&gt;5: 11110&lt;br&gt;6: 0x736B6E616220726F662074756F6C69616220646E6F63657320666F206B6E697262206E6F20726F6C6C65636E61684320393030322F6E614A2F33302073656D695420656854&lt;br&gt;7: B5KR/1r5B/2R5/2b1p1p1/2P1k1P1/1p2P2p/1P2P2P/3N1N2 b - - 0 1&lt;br&gt;openssl enc -aes-256-cbc -d -a -in phase3.txt \&lt;br&gt;  -pass pass:1a57c572caf3cf722e41f5f9cf99ffacff06728a43032dd44c481c77d2ec30d5" vertex="1">
