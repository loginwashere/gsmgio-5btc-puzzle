        <mxCell id="n1059" parent="n1047" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#c9a227;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Courier New;" value="METHOD: password = sha256(&quot;causality&quot;)&lt;br&gt;openssl enc -aes-256-cbc -d -a -in phase2.txt \&lt;br&gt;  -pass pass:eb3efb5151e6255994711fe8f2264427ceeebf88109e1d7fad5b0a8b6d07e5bf" vertex="1">
